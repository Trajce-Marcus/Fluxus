{
  "name": "fluxus",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "concurrently -n server,runtime,console -c blue,green,magenta \"npm:dev:server\" \"npm:dev:runtime\" \"npm:dev:console\"",
    "dev:runtime": "npm run dev --workspace=@fluxus/runtime",
    "dev:console": "npm run dev --workspace=@fluxus/console",
    "dev:server": "npm run dev --workspace=@fluxus/server",
    "seed:server": "npm run seed --workspace=@fluxus/server",
    "build:runtime": "npm run build --workspace=@fluxus/runtime",
    "build:console": "npm run build --workspace=@fluxus/console",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "drizzle-orm": "^0.44.2",
    "typescript": "^5.3.3"
  }
}
