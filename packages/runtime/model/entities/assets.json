{
  "recordType": {
    "id": "rt_assets",
    "name": "Assets",
    "description": "A physical asset belonging to a type.",
    "workflow_ref": "wf_assets",
    "custom_fields": [
      {
        "key": "asset_no",
        "type": "text",
        "default": "",
        "required": true,
        "unique": true,
        "indexed": true
      },
      {
        "key": "status",
        "type": "text",
        "default": "Active",
        "indexed": true
      },
      {
        "key": "serial_no",
        "type": "text",
        "default": ""
      },
      {
        "key": "description",
        "type": "text",
        "default": ""
      },
      {
        "key": "asset_type_id",
        "type": "fk_ref",
        "default": "",
        "required": true,
        "indexed": true,
        "fk_record_type": "rt_asset_types",
        "fk_display_field": "code"
      }
    ]
  },
  "workflow": {
    "id": "wf_assets",
    "name": "Assets",
    "description": "Manage asset records.",
    "activities": [
      {
        "activity_ref": "act_create_assets"
      },
      {
        "activity_ref": "act_update_assets"
      },
      {
        "activity_ref": "act_delete_assets"
      }
    ]
  },
  "activities": [
    {
      "id": "act_create_assets",
      "name": "Create Asset",
      "description": "Creates a new Asset record.",
      "record_map": "CREATE",
      "attributes": [
        {
          "attribute_ref": "asset_no"
        },
        {
          "attribute_ref": "serial_no",
          "required": true,
          "can_waive": true
        },
        {
          "attribute_ref": "description"
        },
        {
          "attribute_ref": "asset_type_id"
        }
      ],
      "before_hook": null,
      "after_hook": null
    },
    {
      "id": "act_update_assets",
      "name": "Update Asset",
      "description": "Update asset details.",
      "record_map": "UPDATE",
      "attributes": [
        {
          "attribute_ref": "serial_no"
        },
        {
          "attribute_ref": "description"
        },
        {
          "attribute_ref": "status"
        },
        {
          "attribute_ref": "asset_type_id"
        }
      ],
      "before_hook": null,
      "after_hook": null
    },
    {
      "id": "act_delete_assets",
      "name": "Delete Asset",
      "description": "Delete this Asset record.",
      "record_map": "DELETE",
      "_comment": "record_map:DELETE — implemented. 'confirm' attribute must equal 'DELETE' exactly.",
      "attributes": [
        {
          "attribute_ref": "confirm"
        }
      ],
      "before_hook": null,
      "after_hook": null
    }
  ]
}
